name: hirfigyelo

on:
  schedule:
    - cron: "*/10 * * * *"
  workflow_dispatch:

permissions:
  contents: write

# egyszerre csak egy futás mehet, így nem ütköznek a mentések
concurrency:
  group: hirfigyelo
  cancel-in-progress: false

jobs:
  figyel:
    runs-on: ubuntu-latest
    timeout-minutes: 5
    env:
      TZ: Europe/Budapest
      NTFY_TOPIC: ${{ secrets.NTFY_TOPIC }}
    steps:
      - uses: actions/checkout@v4

      - name: Hírek ellenőrzése
        run: python3 hirfigyelo.py

      - name: Eredmények mentése
        run: |
          git config user.name "hirfigyelo"
          git config user.email "hirfigyelo@users.noreply.github.com"
          git add -A
          git diff --staged --quiet && exit 0
          git commit -m "allapot"
          for i in 1 2 3; do
            git push && exit 0
            git pull --rebase -X theirs origin main
          done
          exit 1
